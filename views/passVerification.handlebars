<!DOCTYPE html>
<html lang="en">

<head>
  <style>
    .button {
      background-color: #6E5EC5;
      border: none;
      color: white;
      padding: 10px 15px;
      text-align: center;
      font-size: 12px;
      cursor: pointer;
      top: 50%;
    }

    .button:hover {
      background-color: #7A6CCB;
    }

    table {}

    td {
      text-align: center;
    }
  </style>

</head>

<body style="background-color:white; margin: 0; padding: 0;">
  <table align="center" cellpadding="0" cellspacing="0" width="600"
    style="border-collapse: collapse; text-align: center; table-layout: auto">
    <tr>
      <td class="text-align: center;">

        <img src="data:image/png;base64,{{base64}}" width="220" height="50" />
        {{!-- <td style="color: #6e5ec5;">WebTown</i> --}}
      </td>
    </tr>

    <tr>
      <td style="text-align: left;">
        <h3>Dear {{name}}</h3>
        {{#if isResident}}
        <p>Thank you for registering for the Boundary website. Please click  to verify your email,</p>
        {{else}}
        <p>Congratulations! You are one of  Boundary Families now. Please click  to verify your email,</p>
        {{/if}}
        <a href="{{url}}"><button class="button" type="button">Confirm</button></a>

      </td>
    </tr>
  </table>
  
   <div style="height: 40px; 
      width: 100%; 
      background-color: #5C6BC0 ; 
      margin-top: 110px; 
      border: 1px solid white;
      border-radius: 3px; 
      text-align:center;
      color: white;
      line-height: 40px;
      font-weight: bolder;
      font-size: 18px
      ">
          <span >Live Real Life In A Virtual World</span>
      </div>

</body>

</html>