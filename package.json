{
  "name": "boundary",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "client": "vite",
    "build": "vite build",
    "server": "nodemon server.js",
    "dev": "concurrently --names \"server,client\" \"npm run server --silent\" \"npm run client --silent\"",
    "test": "node --test test/",
    "lint": "eslint . --ext .js,.vue",
    "lint:fix": "eslint . --ext .js,.vue --fix",
    "format": "prettier --write \"**/*.{js,vue,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,vue,json,md}\"",
    "verify": "npm run lint && npm test && npm run build",
    "test:e2e": "node test-e2e/live-verification.js && node test-e2e/subscriptions.js",
    "preview": "vite preview",
    "postinstall": "vue-demi-switch 3"
  },
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@apollo/server": "^4.13.0",
    "@chenfengyuan/vue-qrcode": "^2.0.0",
    "@fingerprintjs/fingerprintjs": "^3.0.3",
    "@google/markerclusterer": "^2.0.8",
    "@graphql-tools/schema": "^10.1.0",
    "@vue/apollo-option": "^4.2.2",
    "bcrypt": "^6.0.0",
    "concurrently": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "express-handlebars": "8.0.1",
    "graphql": "^16.14.2",
    "graphql-subscriptions": "^2.0.0",
    "graphql-tag": "^2.11.0",
    "graphql-ws": "^5.16.2",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.21",
    "lzutf8": "^0.5.6",
    "moment": "^2.24.0",
    "mongoose": "^8.24.3",
    "nodemailer": "^9.0.5",
    "nodemailer-express-handlebars": "^7.0.0",
    "nodemailer-plugin-inline-base64": "^2.1.1",
    "object-sizeof": "^1.6.1",
    "openai": "^4.4.0",
    "pinia": "^4.0.3",
    "puppeteer": "^24.43.1",
    "qrcode": "^1.4.4",
    "quill": "^1.3.7",
    "quill-image-resize-module": "^3.0.0",
    "vue": "^3.5.41",
    "vue-advanced-cropper": "^2.8.9",
    "vue-draggable-resizable": "^3.0.0",
    "vue-masonry": "^0.16.0",
    "vue-router": "^4.6.4",
    "vue2-animate": "^2.1.4",
    "vuetify": "^3.13.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.5.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "vite": "^7.3.6",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-eslint-parser": "^9.4.3"
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "resolutions": {
    "fs-capacitor": "3.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ]
}
