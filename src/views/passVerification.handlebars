<!DOCTYPE html>
<html lang="en">

<head>
  <style>
    .button {
      background-color: #6E5EC5;
      border: none;
      color: white;
      padding: 10px 15px;
      text-align: center;
      font-size: 12px;
      cursor: pointer;
      top: 50%;
    }

    .button:hover {
      background-color: #7A6CCB;
    }

    table {}

    td {
      text-align: center;
    }
  </style>

</head>

<body style="background-color:white; margin: 0; padding: 0;">
  <table align="center" cellpadding="0" cellspacing="0" width="600"
    style="border-collapse: collapse; text-align: left; table-layout: auto">
    <tr>
      <td>

        <img src="data:image/png;base64,{{base64}}" width="65" height="65" /><i style="color: #6e5ec5;">WebTown</i>
      </td>
    </tr>

    <tr>
      <td style="text-align: left;">
        <h3>Dear Mr. {{name}}</h3>
        <p>Please click to verify your email:</p>
        <a href="{{url}}"><button class="button" type="button">Confirm</button></a>

      </td>
    </tr>
  </table>

</body>

</html>