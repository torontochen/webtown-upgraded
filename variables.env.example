# Copy this file to `variables.env` and fill in real values.
# `variables.env` is gitignored — never commit real credentials.

# --- Database ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGO_URI_PREFIX=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_URI_SUFFIX=?retryWrites=true&w=majority

# --- Auth ---
# Long random string. Rotating this invalidates every issued JWT.
SECRET=change-me-to-a-long-random-string
# Lifetime for issued tokens (zeit/ms format, e.g. 1h, 12h, 7d)
TOKEN_EXPIRES_IN=12h

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- Outbound mail (Gmail app password, not the account password) ---
MAIL_SERVICE=gmail
MAIL_USER=your-account@gmail.com
MAIL_PASS=your-16-char-app-password

# --- Server ---
PORT=4000
# Where the browser app is served from; used for post-email-verification redirects
CLIENT_ORIGIN=http://localhost:8080
# Comma-separated list of origins allowed to call the API
CORS_WHITELIST=http://localhost:8080

# --- Upload limits ---
MAX_UPLOAD_BYTES=10485760
