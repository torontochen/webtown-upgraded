# Client-side config for `npm run build`.
# Only VUE_APP_* variables are exposed to the browser bundle.
# Contains no secrets — this file is committed on purpose.
#
# Both are intentionally left unset: src/main.js falls back to the origin that
# serves the page, which matches the co-hosted deployment this app used. Set
# them only if the API is hosted separately from the client.
#
# VUE_APP_GRAPHQL_HTTP=https://api.example.com/graphql
# VUE_APP_GRAPHQL_WS=wss://api.example.com/graphql
